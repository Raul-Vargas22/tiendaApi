<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".vista.DetalleProductoActivity">

    <LinearLayout
        android:layout_width="387dp"
        android:layout_height="131dp"
        android:layout_marginStart="1dp"
        android:layout_marginTop="1dp"
        android:layout_marginEnd="1dp"
        android:layout_marginBottom="1dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.299"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.064">

        <TextView
            android:id="@+id/txtDetallePrecio"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/txtDetallePrecio" />

        <TextView
            android:id="@+id/txtDetalleProducto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/txtDetalleProducto" />

        <TextView
            android:id="@+id/txtDetalleDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/txtDetalleDescripcion" />

        <TextView
            android:id="@+id/txtDetalleDescripcionMas"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/txtDetalleDescripcionMas" />
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>